// Database Schema for AI Interview Assistant

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  role      String   @default("INTERVIEWEE") // ADMIN, INTERVIEWER, INTERVIEWEE
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLogin DateTime?

  // Relations
  sessions     Session[]
  candidates   Candidate[] @relation("InterviewerCandidates")
  interviews   Candidate[] @relation("IntervieweeCandidates")

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Candidate {
  id                   String    @id @default(uuid())
  name                 String
  email                String
  phone                String
  resumeFileName       String?
  resumeFileUrl        String?
  resumeText           String?
  currentQuestionIndex Int       @default(0)
  status               String    @default("COLLECTING_INFO") // COLLECTING_INFO, IN_PROGRESS, COMPLETED
  isPaused             Boolean   @default(false)
  startTime            DateTime?
  endTime              DateTime?
  finalScore           Int?
  summary              String?
  remainingTime        Int?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Foreign Keys
  interviewerId String?
  intervieweeId String?

  // Relations
  interviewer User?    @relation("InterviewerCandidates", fields: [interviewerId], references: [id])
  interviewee User?    @relation("IntervieweeCandidates", fields: [intervieweeId], references: [id])
  answers     Answer[]
  messages    ChatMessage[]

  @@map("candidates")
}

model Question {
  id            String   @id @default(uuid())
  text          String
  difficulty    String   // EASY, MEDIUM, HARD
  timeLimit     Int      // in seconds
  category      String
  type          String   @default("TEXT") // MULTIPLE_CHOICE, TEXT
  options       String?  // JSON string for multiple choice options
  correctAnswer String?  // Correct answer for multiple choice
  explanation   String?  // Explanation for the answer
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  answers Answer[]

  @@map("questions")
}

model Answer {
  id             String   @id @default(uuid())
  answer         String
  timeSpent      Int      // in seconds
  difficulty     String   // EASY, MEDIUM, HARD
  score          Int?
  feedback       String?
  isCorrect      Boolean? // For multiple choice questions
  selectedOption String?  // Selected option for multiple choice
  createdAt      DateTime @default(now())

  // Foreign Keys
  candidateId String
  questionId  String

  // Relations
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  question  Question  @relation(fields: [questionId], references: [id])

  @@map("answers")
}

model ChatMessage {
  id          String   @id @default(uuid())
  type        String   // SYSTEM, USER, QUESTION, TIMER_WARNING, FEEDBACK
  content     String
  questionId  String?
  difficulty  String?  // EASY, MEDIUM, HARD
  timeLimit   Int?
  timestamp   DateTime @default(now())

  // Foreign Keys
  candidateId String

  // Relations
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

// Note: SQLite doesn't support enums, so we use String fields with comments indicating valid values
// UserRole: ADMIN, INTERVIEWER, INTERVIEWEE
// CandidateStatus: COLLECTING_INFO, IN_PROGRESS, COMPLETED  
// QuestionDifficulty: EASY, MEDIUM, HARD
// QuestionType: MULTIPLE_CHOICE, TEXT
// MessageType: SYSTEM, USER, QUESTION, TIMER_WARNING, FEEDBACK
